# Copy to .env at the repo root. Mock providers start the app with no API key.

# ------------------------------------------------------------
# DATABASE CREDENTIALS
# Local Postgres. Compose reads these for the database service.
# ------------------------------------------------------------
POSTGRES_USER=docinsight
POSTGRES_PASSWORD=docinsight
POSTGRES_DB=docinsight
DATABASE_URL=postgresql+psycopg://docinsight:docinsight@localhost:5432/docinsight

# ------------------------------------------------------------
# S3 STORAGE CREDENTIALS
# Local MinIO. These are dev credentials, not a cloud account.
# This is the only storage adapter. Compose sets S3_ENDPOINT to http://minio:9000 for the API container.
# ------------------------------------------------------------
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=doc-insight
S3_REGION=us-east-1
S3_ACCESS_KEY=docinsight
S3_SECRET_KEY=docinsight

# ------------------------------------------------------------
# JOB QUEUE CONFIGURATION
# Procrastinate is the only queue provider.
# ------------------------------------------------------------
QUEUE_PROVIDER=procrastinate

# 20 MiB per file, pages per file, files per job.
MAX_FILE_BYTES=20971520
MAX_PAGE_COUNT=100
MAX_FILE_COUNT=10

# A waiting job expires after 24 hours. A stored file with no job is deleted after 1 hour.
# MAINTENANCE_CRON is how often those checks run. The default is every 15 minutes.
AWAITING_INPUT_TIMEOUT_SECONDS=86400
ORPHAN_MAX_AGE_SECONDS=3600
MAINTENANCE_CRON="*/15 * * * *"

# ------------------------------------------------------------
# LLM AND CLASSIFIER CONFIGURATION
# ------------------------------------------------------------
# Set your Cloudflare account id here if using Cloudflare as the LLM or classifier provider.
CLOUDFLARE_ACCOUNT_ID=
# Gateway whose Workers AI billing is Unified billing. Both Cloudflare calls send it as cf-aig-gateway-id.
CLOUDFLARE_AI_GATEWAY_ID=default

# set provider to mock if you have no live inference provider.
LLM_PROVIDER=mock
LLM_MODEL=@cf/zai-org/glm-5.3
LLM_BASE_URL=https://api.cloudflare.com/client/v4
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
# How many times to ask again when a summary does not match the schema.
LLM_OUTPUT_RETRIES=2
STEP_TIMEOUT_SECONDS=60
# Tokens per chunk, counted with the cl100k encoding. A full page of text stays one chunk.
CHUNK_TOKEN_BUDGET=2048

# set provider to mock if you have no live inference provider.
CLASSIFIER_PROVIDER=cloudflare
CLASSIFIER_MODEL=typesafe/jev
CLASSIFIER_BASE_URL=https://api.cloudflare.com/client/v4
CLASSIFIER_API_KEY=
CLASSIFIER_TIMEOUT_SECONDS=30
# Chunk classifies as injection if probability is above threshold.
CLASSIFIER_FLAG_THRESHOLD=0.7
SYSTEM_PROMPTS_PATH=app/pipeline/prompts.yaml

# ------------------------------------------------------------
# TEST CONFIGURATION
# ------------------------------------------------------------
TEST_POSTGRES_USER=docinsight
TEST_POSTGRES_PASSWORD=docinsight
TEST_POSTGRES_DB=docinsight_test

# Pause each mock pipeline step so a poll can see extracting, checking, and summarising.
MOCK_STEP_DELAY_SECONDS=1
